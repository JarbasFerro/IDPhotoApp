            "value" : "Luz uniforme de frente, sem sombras fortes"
          }
        }
      }
    },
    "Evens out exposure and removes colour tints. Nothing on your face is retouched." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iguala la exposición y elimina dominantes de color. No se retoca nada de tu cara."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equilibra a exposição e remove tons de cor. Nada no seu rosto é retocado."
          }
        }
      }
    },
    "Everything we can measure is fine. Also check by eye: neutral expression, eyes open, no glare on glasses." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que podemos medir está bien. Revisa también a ojo: expresión neutra, ojos abiertos, sin reflejos en las gafas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo o que podemos medir está certo. Confira também a olho: expressão neutra, olhos abertos, sem reflexo nos óculos."
          }
        }
      }
    },
