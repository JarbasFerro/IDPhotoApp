      }
    },
    "The four checks": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cuatro comprobaciones"
          }
        }
      }
    },
    "The head cannot be framed to the official size. Retake a little farther away.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede encuadrar la cabeza al tamaño oficial. Repite la foto un poco más lejos."
          }
        }
      }
    },
    "The lens may be smudged. Clean it and retake for a sharper photo.": {
      "comment": "A warning message displayed when the lens of a camera is smudged.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que la lente esté sucia. Límpiala y repite la foto para más nitidez."
          }
        }
      }
    },
    "The operation could not be completed. Try again or choose another photo.": {
      "localizations": {
        "en": {
