        }
      }
    },
    "The face is very bright; reduce the light or move away from the window": {
      "comment": "Text displayed in a warning banner at the top of the screen when the photo is too bright.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cara está muy clara; reduce la luz o apártate de la ventana"
