    },
    "%@ · %lld page(s) · %lld of %lld copies placed": {
      "comment": "A label summarizing the paper size, number of pages, and number of printed copies. The argument is the value of the localized string key “10 × 15 cm (100 × 150 mm)”, the string “4 × 6 in (101.6 × 152.4 mm)”, the string “13 × 18 cm · 5 × 7 in”, the string “9 × 13 cm · 3.5 × 5 in”, the string “A6 (105 × 148 mm)”, the string “A4 (210 × 297 mm)”, the string “US Letter (8.5 × 11 in)”, the string “Custom %1$arg × %2$arg mm”, or the value of the localized string key “A5 (148 × 210 mm)”.",
      "extractionState": "stale",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$lld page(s) · %3$lld of %4$lld copies placed"
