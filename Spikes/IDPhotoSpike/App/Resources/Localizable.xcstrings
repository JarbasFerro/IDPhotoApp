    "Auto" : {
      "comment" : "A label for a toggle that enables automatic photo capture.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto"
          }
        }
      }
    },
    "Auto: when the ring closes, a 3-second countdown runs and the photo is taken for you. Off, you press the shutter yourself." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto: cuando el anillo se cierra, empieza una cuenta atrás de 3 segundos y la foto se hace sola. Desactivado, pulsas tú el disparador."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto: quando o anel se fecha, começa uma contagem regressiva de 3 segundos e a foto é tirada sozinha. Desativado, você mesmo pressiona o obturador."
          }
        }
      }
    },
    "Automatic" : {
